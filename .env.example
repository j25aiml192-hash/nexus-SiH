# ==============================================================================
# NEXUS Environment Configuration Template (.env.example)
# ==============================================================================

# --- Frontend Environment Variables (Vercel) ---
# Centralized REST API base URL pointing to the backend
VITE_API_BASE_URL=http://localhost:8000
# Realtime WebSocket Mesh Node URL
VITE_SOCKET_URL=http://localhost:8000
# Data source mode: 'api' (production default)
VITE_DATA_SOURCE=api
# Optional CARTO basemap key for higher map request limits
VITE_CARTO_API_KEY=

# --- Backend Environment Variables (Render) ---
# Deployment environment: 'development' or 'production'
NEXUS_ENV=development
# Port assigned by Render or local runner
PORT=8000
# Allowed frontend domain for CORS (e.g., https://nexus.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# --- Database & Auth (Supabase) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Intelligence & Notifications ---
# Claude / Anthropic API Key for narrative intelligence briefs
ANTHROPIC_API_KEY=your-anthropic-api-key
# ntfy.sh notification topic for emergency law-enforcement dispatches
NTFY_TOPIC=nexus-alerts-sih2025
