# ==============================================================================
# NEXUS Backend Environment Variables (Render)
# ==============================================================================

# Deployment environment: 'development' or 'production'
NEXUS_ENV=development
# Port assigned dynamically by Render ($PORT) or local fallback
PORT=8000
# Allowed frontend domain for CORS (e.g., https://nexus.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# --- Database & Auth (Supabase) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Intelligence & Notifications ---
# Claude / Anthropic API Key for narrative intelligence briefs
ANTHROPIC_API_KEY=your-anthropic-api-key
# ntfy.sh notification topic for emergency law-enforcement dispatches
NTFY_TOPIC=nexus-alerts-sih2025
