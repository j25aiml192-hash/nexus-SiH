# ==============================================================================
# NEXUS Frontend Environment Variables (Vercel)
# ==============================================================================

# Centralized REST API Base URL (FastAPI Backend)
# In production on Vercel set this to: https://<your-backend-app>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Base REST API fallback
VITE_API_URL=http://localhost:8000

# Realtime WebSocket Mesh Node URL
VITE_SOCKET_URL=http://localhost:8000

# NEXUS Data Layer Mode ('api' in production)
VITE_DATA_SOURCE=api

# Optional CARTO Maps API Key
VITE_CARTO_API_KEY=
